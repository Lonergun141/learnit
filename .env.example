# LearnIT environment variables — names and placeholders only.
#
# Copy to .env.local (git-ignored) and fill in real values there.
# Verify which names are still missing with: npm run env:check
# Never commit real values, and never paste them into logs or issues.

# -----------------------------------------------------------------------------
# Next.js web application. Set the same names in the Vercel project.
# The web app needs no service-role key: every read and write goes through RLS.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's publishable (formerly anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of the deployed app, e.g. https://learnit.example — no trailing slash.
NEXT_PUBLIC_APP_URL=
TELEGRAM_BOT_USERNAME=learnit_teampura_bot

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets.
# Deploy with: npx supabase secrets set --env-file ./.env.local
# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY itself;
# do not set those two as function secrets.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPADATA_API_KEY=
FIRECRAWL_API_KEY=
TELEGRAM_BOT_TOKEN=
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token and checked before any
# request body is parsed. Generate a fresh random value, for example:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Shared between the cron invocation and the process-learning-jobs function.
# Generate the same way as TELEGRAM_WEBHOOK_SECRET. The worker rejects every
# request without it, so an absent value fails closed rather than open.
INTERNAL_CRON_SECRET=
# Public origin used to build topic links inside the Telegram digest.
# Same value as NEXT_PUBLIC_APP_URL.
APP_BASE_URL=

# -----------------------------------------------------------------------------
# Not environment variables: the hourly/minutely cron invocation reads these
# from Supabase Vault inside the database. See docs/DEPLOYMENT.md.
#
#   project_url            https://<project-ref>.supabase.co
#   internal_cron_secret   the same value as INTERNAL_CRON_SECRET above
# -----------------------------------------------------------------------------
